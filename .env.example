BIND_ADDR=0.0.0.0:3000
DATA_FILE=data/db.json

# The app has no login of its own. Put everything except /webhook behind
# Cloudflare Access (see deploy/README.md).

# Meta app (developers.facebook.com > your app)
META_APP_SECRET=
# Any string; paste the same value into the webhook setup in the Meta app
META_VERIFY_TOKEN=
META_PAGE_ID=
# Page access token with leads_retrieval + pages_manage_metadata + pages_show_list
# (use a long-lived or system-user token so it doesn't expire)
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0

# Web Push: run `cargo run -p meta-leads-backend -- vapid` once and paste the output here
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
