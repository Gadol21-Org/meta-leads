BIND_ADDR=0.0.0.0:3000
DATA_FILE=data/db.json

# The app has no login of its own. Put everything except /webhook behind
# Cloudflare Access (see deploy/README.md).

# Meta app (developers.facebook.com > your app)
META_APP_SECRET=
# Any string; paste the same value into the webhook setup in the Meta app
META_VERIFY_TOKEN=
# Which Page(s) to read leads from. Use ONE of these styles (they can be mixed):
#  1. One Page:
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
#  2. Several Pages, one token each: pageId:token,pageId:token
META_PAGE_TOKENS=
#  3. Several Pages, one system-user token (the app derives each Page's token at startup).
#     META_PAGE_IDS is optional: empty means every Page the token can see.
META_USER_TOKEN=
META_PAGE_IDS=
META_GRAPH_VERSION=v21.0

# Web Push: run `cargo run -p meta-leads-backend -- vapid` once and paste the output here
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
