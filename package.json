{
  "name": "meta-leads",
  "version": "0.1.0",
  "private": true,
  "description": "PWA that pushes a notification for every new Meta Lead Ads lead and lets you move leads between stages.",
  "type": "module",
  "main": "src/index.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "vapid": "node scripts/generate-vapid.js",
    "simulate": "node scripts/simulate-lead.js",
    "icons": "node scripts/make-icons.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "web-push": "^3.6.7"
  }
}
